---
import Layout from '../layouts/Layout.astro';
import EmergencyBar from '../components/EmergencyBar.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import ServiceStrip from '../components/ServiceStrip.astro';
import Services from '../components/Services.astro';
import WhyUs from '../components/WhyUs.astro';
import Process from '../components/Process.astro';
import Reviews from '../components/Reviews.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
---

<Layout>
  <div id="top" class="page">
    {site.showEmergencyBar && <EmergencyBar />}
    <Nav />
    <main id="main">
      <Hero />
      {site.showServiceStrip && <ServiceStrip />}
      <Services />
      <WhyUs />
      <Process />
      <Reviews />
      <CtaBanner />
      <Contact />
    </main>
    <Footer />
  </div>
</Layout>

<style>
  .page {
    width: 100%;
    overflow-x: hidden;
  }
</style>
