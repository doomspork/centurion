---
/**
 * Centurion Restoration crest — a heraldic shield with a laurel-framed
 * compass star. Pure inline SVG so it needs no asset file (nothing to break
 * under the GitHub Pages `base` path) and inherits its color from the parent
 * via `currentColor`.
 */
interface Props {
  size?: number;
  class?: string;
  /** Accessible name. Pass an empty string to render the crest as decorative. */
  title?: string;
}
const { size = 52, class: className, title = 'Centurion Restoration crest' } = Astro.props;

// When the crest sits next to a text wordmark (e.g. the footer) it's decorative:
// an empty title means "hide me from assistive tech" rather than an empty label.
const decorative = title === '';
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  role={decorative ? undefined : 'img'}
  aria-label={decorative ? undefined : title}
  aria-hidden={decorative ? 'true' : undefined}
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  {!decorative && <title>{title}</title>}
  <!-- shield -->
  <path
    d="M12 10 H52 V31 C52 45 43.5 53 32 58 C20.5 53 12 45 12 31 Z"
    fill="rgba(200,153,63,0.12)"
    stroke="currentColor"
    stroke-width="2"
    stroke-linejoin="round"
  ></path>
  <!-- inner hairline -->
  <path
    d="M17 15 H47 V30.5 C47 41.5 40 48.5 32 52.5 C24 48.5 17 41.5 17 30.5 Z"
    stroke="currentColor"
    stroke-width="1"
    opacity="0.45"
    stroke-linejoin="round"
  ></path>
  <!-- laurel -->
  <g stroke="currentColor" stroke-width="1.3" stroke-linecap="round" opacity="0.85">
    <path d="M22.5 33 C19.5 38 20 43.5 23.5 48"></path>
    <path d="M21.3 36.5 L18 35.8"></path>
    <path d="M20.9 40.8 L17.6 40.8"></path>
    <path d="M21.6 45 L18.6 46"></path>
    <path d="M41.5 33 C44.5 38 44 43.5 40.5 48"></path>
    <path d="M42.7 36.5 L46 35.8"></path>
    <path d="M43.1 40.8 L46.4 40.8"></path>
    <path d="M42.4 45 L45.4 46"></path>
  </g>
  <!-- compass star -->
  <path d="M32 24 L35.6 32.4 L44 36 L35.6 39.6 L32 48 L28.4 39.6 L20 36 L28.4 32.4 Z" fill="currentColor"
  ></path>
</svg>

<style>
  /* Owned by the component so it always applies (a parent's scoped styles
     can't reach this SVG). The color comes from the ancestor via currentColor. */
  svg {
    flex: none;
  }
</style>
