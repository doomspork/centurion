---
import { services } from '../data/site';
---

<section id="services" class="section services">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">What We Restore</span>
      <h2 class="section-title">Four Fronts. One Standard.</h2>
    </div>

    <div class="grid">
      {
        services.map((s) => (
          <article class="card">
            <div class="coin">{s.numeral}</div>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services {
    background: var(--cream);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 22px;
  }
  .card {
    background: #fff;
    border: 1px solid rgba(107, 31, 46, 0.14);
    border-top: 3px solid var(--gold);
    border-radius: 5px;
    padding: 30px 26px 32px;
  }
  .coin {
    width: 58px;
    height: 58px;
    border-radius: 50%;
    border: 2px solid var(--gold);
    color: var(--maroon);
    font-size: 22px;
    background: rgba(200, 153, 63, 0.1);
    margin-bottom: 20px;
  }
  .card h3 {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--ink);
    font-size: 19px;
    margin: 0 0 10px;
    letter-spacing: 0.02em;
  }
  .card p {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0;
  }
</style>
