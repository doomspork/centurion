---
import { site, nav } from '../data/site';
import Crest from './Crest.astro';
---

<header class="nav">
  <a class="brand" href="#top" aria-label={`${site.name} home`}>
    <Crest size={52} class="brand-crest" />
    <span class="brand-word">
      <span class="brand-name">CENTURION</span>
      <span class="brand-sub">RESTORATION</span>
    </span>
  </a>

  <nav class="nav-links" aria-label="Primary">
    {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    <a class="nav-cta" href={site.phoneHref}>Call {site.phone}</a>
  </nav>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 14px clamp(20px, 4vw, 48px);
    background: rgba(251, 246, 236, 0.94);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(107, 31, 46, 0.12);
    flex-wrap: wrap;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 13px;
    /* Crest inherits this via currentColor; the wordmark spans set their own. */
    color: var(--maroon);
  }
  .brand-word {
    line-height: 1.05;
    display: block;
  }
  .brand-name {
    display: block;
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--maroon);
    font-size: 16px;
    letter-spacing: 0.05em;
  }
  .brand-sub {
    display: block;
    font-family: var(--font-condensed);
    font-weight: 600;
    color: var(--gold);
    font-size: 11px;
    letter-spacing: 0.34em;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: clamp(14px, 2vw, 28px);
    font-family: var(--font-condensed);
    text-transform: uppercase;
    letter-spacing: 0.13em;
    font-weight: 600;
    font-size: 13.5px;
    flex-wrap: wrap;
  }
  .nav-links a {
    color: var(--ink);
    transition: color 0.18s;
  }
  .nav-links a:hover {
    color: var(--maroon);
  }
  .nav-cta {
    background: linear-gradient(180deg, var(--gold-light), var(--gold));
    color: #3a1118 !important;
    padding: 11px 20px;
    border-radius: 3px;
    border: 1px solid #b0832f;
    letter-spacing: 0.1em;
  }
</style>
