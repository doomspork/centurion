---
/**
 * Base document shell. This is the Astro equivalent of the original
 * design-tool `<helmet>` block: it owns everything inside `<head>` — meta,
 * fonts, favicon, and the global stylesheet — and renders page content
 * through `<slot />`.
 */
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Centurion Restoration — Water, Fire, Mold & Asbestos Restoration',
  description = 'A small, elite crew of certified restoration specialists. 24/7 emergency response for water, fire, mold, and asbestos — licensed, insured, and billing your insurance directly.',
} = Astro.props;

// Join `base` to a public asset with exactly one slash — `BASE_URL` may or may
// not carry a trailing slash depending on config, so normalize it here.
const faviconHref = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`;

// Absolute URLs for canonical + social cards (Astro.site is set in astro.config).
const canonicalURL = Astro.site ? new URL(import.meta.env.BASE_URL, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(faviconHref, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#6B1F2E" />
    <meta name="generator" content={Astro.generator} />
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Centurion Restoration" />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    {ogImage && <meta property="og:image" content={ogImage} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <!-- Fonts (carried over from the original design) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800;900&family=Barlow:wght@400;500;600;700&family=Barlow+Condensed:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />
  </body>
</html>
